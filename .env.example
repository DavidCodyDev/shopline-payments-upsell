# Server
PORT=3000
APP_URL=http://localhost:3000

# SHOPLINE app credentials (required for live Admin API / OAuth later)
# Docs: https://developer.shopline.com/docs/apps/api-instructions-for-use/app-authorization
SHOPLINE_APP_KEY=
SHOPLINE_APP_SECRET=

# Store handle / domain used in Admin REST base URL
# Example Admin REST: https://{handle}.myshopline.com/admin/openapi/v20260601/...
SHOPLINE_STORE_HANDLE=

# Access token from OAuth (public/custom) or private-app Admin token.
# Without this, draft-order creation stays in stub/mock mode.
SHOPLINE_ACCESS_TOKEN=

# Optional: Admin API version path segment (default below)
SHOPLINE_API_VERSION=v20260601

# When true (default without token), /api/checkout-link returns a mock checkout URL.
# Set to false only when SHOPLINE_ACCESS_TOKEN is set and you want live draft-order calls.
USE_MOCK_DRAFT_ORDER=true
