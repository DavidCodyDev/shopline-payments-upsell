# Server
PORT=3000
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# SHOPLINE credentials (never commit real values)
# Docs: https://developer.shopline.com/docs/apps/api-instructions-for-use/app-authorization
# Draft order: https://developer.shopline.com/docs/admin-rest-api/order/draft-order/create-a-draft-order
# ---------------------------------------------------------------------------

# Partner App Key / Secret — needed later for OAuth (public/custom apps).
# Private apps can skip these and use SHOPLINE_ACCESS_TOKEN from Admin instead.
SHOPLINE_APP_KEY=
SHOPLINE_APP_SECRET=

# Store handle (prefix of {handle}.myshopline.com). Required for live Admin API
# unless you set SHOPLINE_API_BASE.
SHOPLINE_STORE_HANDLE=

# Access token: private-app Admin token (≈3y) OR OAuth access token (≈10h).
# Scope needed for draft orders: write_draft_orders
# Without this, /api/checkout-link stays in mock mode.
SHOPLINE_ACCESS_TOKEN=

# Optional: full Admin OpenAPI base URL (no trailing slash). Overrides handle+version.
# Example: https://open001.myshopline.com/admin/openapi/v20260901
SHOPLINE_API_BASE=

# Admin API version path segment when using store handle (default below).
SHOPLINE_API_VERSION=v20260901

# Force mock checkout URLs even if credentials are present.
# Without credentials, mock is always used regardless of this flag.
# Set to false only when you intentionally want live draft-order calls.
USE_MOCK_DRAFT_ORDER=true
